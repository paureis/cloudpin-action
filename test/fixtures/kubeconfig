# A kubeconfig for the test workflow: one context whose server is a reserved,
# unresolvable name. cloudpin reads it without network access, so the action
# runs against a real CLI with no cloud account.
apiVersion: v1
kind: Config
clusters:
  - name: fake
    cluster:
      server: https://a.example.invalid
contexts:
  - name: fake
    context:
      cluster: fake
      user: fake
current-context: fake
users:
  - name: fake
    user: {}
